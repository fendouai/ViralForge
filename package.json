{
  "name": "viralforge",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15"
  },
  "type": "module",
  "description": "Agent-native viral video studio: one-click replicate viral short videos, deconstruct video scripts into a Viral DNA report, and generate 10 costed variants. Skill + MCP + CLI, local-first, Apache-2.0.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "start": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "audio": "python3 scripts/make_audio.py",
    "render": "node scripts/render-cases.mjs",
    "render:en": "node scripts/render-cases.mjs --lang en",
    "docs:images": "node scripts/render-docs-images.mjs",
    "docs:posters": "node scripts/render-demo-posters.mjs",
    "test": "node tests/smoke.mjs",
    "test:readme": "node tests/readme.mjs",
    "test:media": "node tests/media.mjs",
    "test:mcp": "node tests/mcp.mjs",
    "test:all": "npm run test:readme && npm run test && npm run test:media && npm run test:mcp",
    "pretest": "npm run build",
    "doctor": "node scripts/doctor.mjs",
    "release:archive": "sh scripts/archive-release.sh"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "playwright": "^1.55.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "bin": {
    "viralforge": "./cli/viralforge.mjs"
  },
  "author": "ViralForge contributors",
  "keywords": [
    "viral-video",
    "viral-video-replication",
    "short-video",
    "video-script",
    "video-script-deconstruction",
    "one-click-replication",
    "video-remix",
    "video-editing",
    "ai-agent",
    "ai-agents",
    "agent-native",
    "mcp",
    "mcp-server",
    "claude-code",
    "ffmpeg",
    "video-generation",
    "ugc",
    "ugc-ads",
    "advertising",
    "content-repurposing",
    "viral-marketing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fendouai/ViralForge.git"
  },
  "bugs": {
    "url": "https://github.com/fendouai/ViralForge/issues"
  },
  "homepage": "https://github.com/fendouai/ViralForge#readme"
}
